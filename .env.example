# =========================================================
# Sonichecks Configuration Environment Variables
# =========================================================

# Audio Engine Service URL
AUDIO_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_AUDIO_ENGINE_URL=http://localhost:8000

# Audio Processing Constraints
MAX_BATCH_SIZE=50
MAX_CONCURRENT_ANALYSES=4
MAX_FILE_SIZE_BYTES=262144000
TEMP_UPLOAD_DIR=./tmp_uploads
ANALYSIS_TIMEOUT_SECONDS=120

# Creem Payment Checkout (Test / Production)
CREEM_API_KEY=creem_test_your_key_here
NEXT_PUBLIC_CREEM_API_KEY=creem_test_your_key_here

# Supabase / PostgreSQL (Persistent Storage & Auth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sonichecks
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Billing (Alternative / Future)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
