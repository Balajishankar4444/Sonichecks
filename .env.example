# =========================================================
# Sonichecks Configuration Environment Variables
# =========================================================

# Audio Engine Service URL
AUDIO_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_AUDIO_ENGINE_URL=http://localhost:8000

# Audio Processing Constraints
MAX_FILE_SIZE_BYTES=262144000
TEMP_UPLOAD_DIR=./tmp_uploads
ANALYSIS_TIMEOUT_SECONDS=120

# Supabase / PostgreSQL (Persistent Storage & Auth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sonichecks
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Billing (When ready to accept live payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
